/dts-v1/;

#include <wch/ch32v307/ch32v307wc.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include "uptp_v1-pinctrl.dtsi"

/ {
	model = "bojit_uptp_v1";
	compatible = "bojit,uptp_v1";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,console = &usart4;
		zephyr,shell-uart = &usart4;
	};
};

&clk_hse {
	clock-frequency = <DT_FREQ_M(8)>;
	status = "okay";
};

&pll {
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
};


&gpioa {
	status = "okay";
};

&gpioc {
	status = "okay";
};

&usart4 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&usart4_default>;
	pinctrl-names = "default";
};
